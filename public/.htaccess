# SPA fallback для TanStack Router: любые несуществующие пути отдают index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Не переписывать реальные файлы и папки
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — в index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Кэш ассетов
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
